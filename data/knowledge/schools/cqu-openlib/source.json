  "discovery": {
    "type": "sitemap",
    "url": "https://cqu-openlib.cn/sitemap.xml",
    "include_prefixes": ["/academic", "/club", "/skill", "/life", "/contributor", "/sundry", "/course", "/map"],
    "exclude_prefixes": ["/admin", "/42"]
