      "type": "nav-index",
      "url": "https://cqu-openlib.cn/nav-index.json",
      "section": "course"
    }
  },
  "crawl": {
    "concurrency": 3,
    "delay_ms": 250,
    "timeout_seconds": 25,
    "max_pages": 1200,
    "user_agent": "MikuAI-KnowledgeBot/1.0 (+local fan project; respects robots.txt)"
  }
}